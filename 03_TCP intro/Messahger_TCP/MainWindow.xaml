<Window x:Class="Messahger_TCP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Messahger_TCP"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <Label FontSize="15" FontWeight="Bold" Margin="10">Message :</Label>
            <Button  Margin="5" Padding="20 10" DockPanel.Dock="Right" Click="ConnectButton_Click">Connect</Button>
            <Button Margin="5" Padding="20 10" DockPanel.Dock="Right" Click="DisconnectButton_Click">Disconnect</Button>
            <Button Margin="5" Padding="20 10" DockPanel.Dock="Right" Click="SendButtonClick">Send</Button>
            <TextBox x:Name="msgTextBox" VerticalContentAlignment="Center"></TextBox>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" TextAlignment="Center" FontWeight="Bold" FontSize="25">Chat</TextBlock>
        <ListBox ItemsSource="{Binding}"></ListBox>
    </DockPanel>

</Window>
